# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ai_website_builder?schema=public"
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=15m
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=your-openrouter-model
VERCEL_TOKEN=your-vercel-token
NETLIFY_TOKEN=your-netlify-token
NETLIFY_BUILD_WORKER_URL=https://isolated-worker.example.internal/build
NETLIFY_BUILD_WORKER_SECRET=replace-with-a-dedicated-worker-secret

# Optional resource limits
MAX_PROJECT_FILES=200
MAX_PROJECT_BYTES=20000000
MAX_FILE_BYTES=500000
MAX_PROMPT_CHARACTERS=10000
MAX_VERSIONS_PER_PROJECT=100
MAX_ACTIVE_DEPLOYMENTS=2
MAX_BUILD_OUTPUT_FILES=500
MAX_BUILD_OUTPUT_BYTES=30000000
DEPLOYMENT_START_TIMEOUT_MS=600000

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/github/callback

# Client
VITE_API_URL=http://localhost:5000/api
